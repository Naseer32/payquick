# PayQuick environment variables
# Copy this file to .env and fill in the values.
# Never commit .env or any file containing real secrets.

# ── Frontend (apps/web) — set in Vercel dashboard ────────────────────────────

# URL of the deployed PayQuick API. No trailing slash.
VITE_API_URL=https://payquick.onrender.com

# Network: "testnet" (default) or "mainnet"
# Controls which Arc chain the frontend expects.
VITE_ARC_NETWORK=testnet

# ── API (apps/api) — set in Render dashboard ─────────────────────────────────

# Network the API verifies payments on: "testnet" (default) or "mainnet"
# Must match VITE_ARC_NETWORK on the frontend.
ARC_NETWORK=testnet

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/payquick

# Express server port (Render sets this automatically)
PORT=3000

# Allowed CORS origins, comma-separated. Set to your Vercel frontend URL.
CORS_ORIGINS=https://payquick.vercel.app

# Session secret — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── RPC endpoints (optional overrides) ───────────────────────────────────────

# Arc Testnet RPC. Default: https://rpc.testnet.arc.io
# ARC_TESTNET_RPC_URL=

# Arc Mainnet RPC. Default: https://rpc.mainnet.arc.io
# Required when ARC_NETWORK=mainnet.
# ARC_MAINNET_RPC_URL=

# ── PaymentTracker contract (optional) ───────────────────────────────────────

# Testnet contract address (enables contract-mode verification)
# PAYMENT_TRACKER_ADDRESS_TESTNET=

# Mainnet contract address — must be set before ARC_NETWORK=mainnet
# PAYMENT_TRACKER_ADDRESS_MAINNET=

# keccak256("PaymentSent(address,address,uint256,string)") — same on both networks
# PAYMENT_SENT_TOPIC=
